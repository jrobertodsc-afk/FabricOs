# =============================================================
# FabricOS — Template de Configurações de Ambiente
# =============================================================
# Copie este arquivo como .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no Git!
# =============================================================

# ---- Segurança ----
# Gere uma nova chave com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=SUBSTITUA_POR_UMA_CHAVE_GERADA_ALEATORIAMENTE

# ---- Banco de Dados ----
# SQLite (desenvolvimento local):
DATABASE_URL=sqlite+aiosqlite:///./fabricos.db
# PostgreSQL (produção) — descomente e configure:
# DATABASE_URL=postgresql+asyncpg://usuario:senha@localhost:5432/fabricos_db

# ---- CORS ----
# Origens permitidas, separadas por vírgula
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Aplicação ----
DEBUG=false

# ---- Trello Integration ----
TRELLO_API_KEY=
TRELLO_TOKEN=

